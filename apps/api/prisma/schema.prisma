generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Identity
// -----------------------------------------------------------------------------
// See docs/build-plan.md section 4. OTP codes are hashed at rest and never
// logged. National ID numbers on VerificationDoc are handled at the
// application layer (column-level encryption), not by the schema itself.

enum RoleName {
  CUSTOMER
  DRIVER
  MERCHANT_OWNER
  OPS
  SUPPORT
  FINANCE
  SUPER_ADMIN
}

enum CredentialType {
  PHONE_OTP
  EMAIL_PASSWORD
  GOOGLE
  APPLE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleType {
  MOTO
  CAR
  VAN
  BICYCLE
}

enum VerificationOwnerType {
  DRIVER
  MERCHANT
}

enum VerificationDecision {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String     @id @default(uuid())
  phoneE164   String?    @unique
  email       String?    @unique
  displayName String
  locale      String     @default("en")
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  credentials     Credential[]
  refreshTokens   RefreshToken[]
  roles           UserRole[]
  addresses       Address[]
  merchantProfile MerchantProfile?
  driverProfile   DriverProfile?

  @@index([status])
  @@map("users")
}

model Credential {
  id         String         @id @default(uuid())
  userId     String
  type       CredentialType
  secretHash String?
  verifiedAt DateTime?
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("credentials")
}

// Never logged, hashed at rest. purpose distinguishes registration, login and
// account-recovery challenges so a code for one cannot be replayed for another.
model OtpChallenge {
  id         String    @id @default(uuid())
  phoneE164  String
  codeHash   String
  purpose    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneE164, expiresAt])
  @@map("otp_challenges")
}

// tokenHash is the lookup key. familyId ties every rotation of one login
// together so reuse of an already-rotated token revokes the whole family.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  familyId  String
  audience  String
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model UserRole {
  id     String   @id @default(uuid())
  userId String
  role   RoleName

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model MerchantProfile {
  id         String         @id @default(uuid())
  userId     String         @unique
  merchantId String         @unique
  status     ApprovalStatus @default(PENDING)
  createdAt  DateTime       @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_profiles")
}

model DriverProfile {
  id          String         @id @default(uuid())
  userId      String         @unique
  vehicleType VehicleType
  status      ApprovalStatus @default(PENDING)
  rating      Decimal        @default(5.0) @db.Decimal(3, 2)
  standing    String         @default("GOOD")
  createdAt   DateTime       @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability DriverAvailability?
  locations    DriverLocation[]
  offers       DispatchOffer[]
  assignments  Assignment[]

  @@map("driver_profiles")
}

// storageKey points at the object store. The file itself never touches the
// database, and national ID numbers referenced here are encrypted at the
// application layer before being persisted anywhere.
model VerificationDoc {
  id         String                @id @default(uuid())
  ownerType  VerificationOwnerType
  ownerId    String
  docType    String
  storageKey String
  reviewedBy String?
  reviewedAt DateTime?
  decision   VerificationDecision  @default(PENDING)
  createdAt  DateTime              @default(now())

  @@index([ownerType, ownerId])
  @@map("verification_docs")
}

// -----------------------------------------------------------------------------
// Location and configuration
// -----------------------------------------------------------------------------
// Fee structure is a row rather than a constant, so enabling a new city is
// configuration rather than a deployment. FR-ADM-008.

enum Vertical {
  FOOD
  GROCERY
  PARCEL
}

model City {
  id              String     @id @default(uuid())
  code            String     @unique
  name            String
  countryCode     String
  currency        String
  timezone        String
  activeVerticals Vertical[]
  createdAt       DateTime   @default(now())

  zones        Zone[]
  merchants    Merchant[]
  feeSchedules FeeSchedule[]

  @@map("cities")
}

model Zone {
  id              String @id @default(uuid())
  cityId          String
  name            String
  polygon         Json
  deliveryRadiusM Int

  city      City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  merchants Merchant[]

  @@index([cityId])
  @@map("zones")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  landmark  String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  parcelPickups ParcelDetails[]

  @@index([userId])
  @@index([latitude, longitude])
  @@map("addresses")
}

// One row per city, vertical and effective date. A new row supersedes the
// previous one rather than mutating it, which keeps historical orders priced
// against the schedule that was actually in effect at the time.
model FeeSchedule {
  id            String   @id @default(uuid())
  cityId        String
  vertical      Vertical
  baseFeeMinor  BigInt
  perKmFeeMinor BigInt
  serviceFeeBps Int
  effectiveFrom DateTime

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId, vertical, effectiveFrom])
  @@map("fee_schedules")
}

// -----------------------------------------------------------------------------
// Catalog
// -----------------------------------------------------------------------------
// Product.description is user-generated: sanitized on write, rendered as text
// on read, never dangerouslySetInnerHTML.

enum MerchantStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PromotionType {
  PERCENT_OFF
  AMOUNT_OFF
}

model Merchant {
  id              String         @id @default(uuid())
  name            String
  vertical        Vertical
  cityId          String
  zoneId          String
  latitude        Decimal        @db.Decimal(9, 6)
  longitude       Decimal        @db.Decimal(9, 6)
  rating          Decimal        @default(5.0) @db.Decimal(3, 2)
  prepTimeMinutes Int            @default(15)
  isOpen          Boolean        @default(true)
  status          MerchantStatus @default(DRAFT)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  city            City             @relation(fields: [cityId], references: [id])
  zone            Zone             @relation(fields: [zoneId], references: [id])
  merchantProfile MerchantProfile?
  hours           MerchantHours[]
  categories      Category[]
  products        Product[]
  promotions      Promotion[]
  carts           Cart[]
  orders          Order[]

  @@index([cityId, vertical, status])
  @@index([latitude, longitude])
  @@map("merchants")
}

model MerchantHours {
  id         String @id @default(uuid())
  merchantId String
  dayOfWeek  Int
  opensAt    String
  closesAt   String

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@map("merchant_hours")
}

model Category {
  id         String @id @default(uuid())
  merchantId String
  name       String
  sortOrder  Int    @default(0)

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([merchantId])
  @@map("categories")
}

model Product {
  id          String  @id @default(uuid())
  merchantId  String
  categoryId  String?
  name        String
  description String?
  priceMinor  BigInt
  currency    String
  imageKey    String?
  isAvailable Boolean @default(true)
  stockCount  Int?

  merchant       Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id])
  modifierGroups ModifierGroup[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([merchantId, isAvailable])
  @@map("products")
}

model ModifierGroup {
  id        String  @id @default(uuid())
  productId String
  name      String
  minSelect Int     @default(0)
  maxSelect Int     @default(1)
  required  Boolean @default(false)

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ModifierOption[]

  @@index([productId])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String @id @default(uuid())
  groupId         String
  name            String
  priceDeltaMinor BigInt @default(0)

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("modifier_options")
}

model Promotion {
  id             String        @id @default(uuid())
  merchantId     String?
  code           String        @unique
  type           PromotionType
  valueMinor     BigInt?
  valueBps       Int?
  startsAt       DateTime
  endsAt         DateTime
  maxRedemptions Int?

  merchant    Merchant?         @relation(fields: [merchantId], references: [id])
  redemptions PromoRedemption[]

  @@index([merchantId])
  @@map("promotions")
}

