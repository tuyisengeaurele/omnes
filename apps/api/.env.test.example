# Copy to apps/api/.env.test and fill in. Used only by `npm run test`, which
# points at a separate database from local dev so a test run never touches
# omnes_dev data. See README.md for creating the omnes_test database and
# role. .env.test is git-ignored, same as .env.

DATABASE_URL=postgresql://omnes_app:replace-me@localhost:5432/omnes_test?schema=public

NODE_ENV=test
LOG_LEVEL=silent

JWT_ACCESS_SECRET=replace-me-openssl-rand-hex-32
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

CSRF_SECRET=replace-me-openssl-rand-hex-32
OTP_PEPPER=replace-me-openssl-rand-hex-32

COOKIE_DOMAIN=
COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=5

PAYMENT_PROVIDER=mock
PAYMENT_TIMEOUT_SECONDS=180
PAYMENT_WEBHOOK_SECRET=test-payment-webhook-secret-at-least-32-characters-long
SMS_PROVIDER=mock
MAPS_PROVIDER=osm
REALTIME_TRANSPORT=sse

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=10
