# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Generate every secret below with: openssl rand -hex 32
#
# The API validates this file's shape at boot and refuses to start if a
# required variable is missing or malformed, so a misconfigured deploy fails
# loudly at startup instead of quietly at the first request that needs it.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Native Postgres on Windows is the verified local path. See the README.
DATABASE_URL=postgresql://omnes_app:replace-me@localhost:5432/omnes_dev?schema=public

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the short-lived access token. Rotating this invalidates every access
# token immediately, which is the intended emergency lever.
JWT_ACCESS_SECRET=replace-me-openssl-rand-hex-32
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Separate secret so a leaked CSRF secret cannot be used to mint sessions.
CSRF_SECRET=replace-me-openssl-rand-hex-32

# Keys the HMAC used to hash OTP codes at rest. Distinct from the secrets
# above so a leak of one does not also compromise the other.
OTP_PEPPER=replace-me-openssl-rand-hex-32

# Leave blank for localhost. Set to the registrable domain in production.
COOKIE_DOMAIN=
# Must be true anywhere that is not local development.
COOKIE_SECURE=false

# Comma-separated. Never a wildcard, including in local development.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_HOUR=5

# ---------------------------------------------------------------------------
# Adapters
# ---------------------------------------------------------------------------
# Each of these selects an implementation behind a port interface. "mock" is a
# working local implementation that models real failure modes, not a stub that
# always succeeds.
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
MAPS_PROVIDER=osm
REALTIME_TRANSPORT=sse

# MTN Mobile Money. Unused while PAYMENT_PROVIDER=mock.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=replace-me
MTN_MOMO_API_USER=replace-me
MTN_MOMO_API_KEY=replace-me
MTN_MOMO_CALLBACK_SECRET=replace-me-openssl-rand-hex-32

# Airtel Money. Unused while PAYMENT_PROVIDER=mock.
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_CLIENT_ID=replace-me
AIRTEL_CLIENT_SECRET=replace-me
AIRTEL_CALLBACK_SECRET=replace-me-openssl-rand-hex-32

# SMS gateway. Unused while SMS_PROVIDER=mock.
SMS_API_KEY=replace-me
SMS_SENDER_ID=OMNES

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_AUTH_MAX_REQUESTS=10
